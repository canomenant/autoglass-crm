NEXT_PUBLIC_API_URL=http://localhost:4000

# Used by AddressAutocomplete (src/components/AddressAutocomplete.js) — Google Places API (New)
# via PlaceAutocompleteElement. Exposed to the browser bundle (NEXT_PUBLIC_*), so it MUST be
# restricted by HTTP referrer in Google Cloud Console (not just left unrestricted) — see setup
# notes in the PR/commit that added this.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
