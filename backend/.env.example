PORT=4000

# OBLIGATORIO. Mínimo 32 caracteres, generado al azar. El arranque falla si falta, si es corto o
# si es uno de los valores de ejemplo conocidos (src/config/secrets.js) — antes aquí ponía
# "changeme", y como este fichero SÍ se versiona, cualquiera con acceso al repositorio podía
# firmar su propio token { role: "ADMIN" } sin haber tenido nunca una cuenta.
#
# Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Rotarlo invalida todas las sesiones abiertas. Es el efecto deseado.
JWT_SECRET=

# Cifra los secretos TOTP del segundo factor en reposo. Obligatoria para poder activar MFA;
# sin ella, /auth/mfa/setup responde 503 en vez de guardar un secreto en claro.
#
# Separada de JWT_SECRET a proposito: rotar el secreto de sesion es rutinario, y con clave
# compartida cada rotacion dejaria a todo el mundo fuera de su propio segundo factor.
# Perderla equivale a perder los secretos: habria que volver a dar de alta el MFA de cada cuenta.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Orígenes autorizados por CORS, separados por coma. Sin comodines. Si no se define se usa
# FRONTEND_URL. Antes la API respondía Access-Control-Allow-Origin: * a cualquiera.
CORS_ORIGINS=http://localhost:3000

# Break-glass admin login, checked before any stored account. Off unless BOTH are set — leave
# unset in normal operation. Only set temporarily in Railway if the real admin account is
# unreachable; unset again once access is restored. Cada uso queda registrado como [SECURITY]
# en el log del servidor: es la única evidencia de un acceso que se salta todos los controles.
#
# La contraseña va como HASH bcrypt, no en claro — una variable de entorno queda expuesta en el
# panel de Railway, en `printenv` y en cualquier volcado del proceso. Generar el hash con:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],12))" 'la-contraseña'
# EMERGENCY_ADMIN_EMAIL=
# EMERGENCY_ADMIN_PASSWORD_HASH=

DB_HOST=mi_host_mysql_de_hostinger
DB_PORT=3306
DB_USER=mi_usuario_mysql
DB_PASSWORD=mi_contraseña_mysql
DB_NAME=mi_nombre_de_base

# Railway PostgreSQL (app_data cache + primary datastore for the migrated stores below)
#
# El cifrado no es opcional fuera de localhost: node-postgres NO cifra por defecto, y este host
# se alcanza por Internet. Sin TLS, la contraseña y todas las filas devueltas —clientes, pagos,
# comisiones, adjuntos de siniestros— viajan en claro. Lo activa src/config/db.js; no hace falta
# sslmode en la URL (choca con el objeto ssl explícito y avisa por compatibilidad libpq).
DATABASE_URL=postgresql://user:password@host:port/database

# TLS: por defecto se valida contra backend/certs/railway-root-ca.pem, la CA propia con la que
# Railway firma el certificado de su proxy (no es una CA pública, por eso el almacén del sistema
# la rechaza). Ese fichero NO es un secreto: es un certificado, material público.
#
# Sólo hace falta tocar esto si cambia el proveedor o si Railway rota su raíz (caduca en oct 2028):
# DATABASE_CA_CERT=          # la CA en PEM, en línea — cómodo para Railway
# DATABASE_CA_CERT_FILE=     # o la ruta a un .pem — cómodo en local
#
# El certificado de hoja del proxy lleva CN=localhost, no el nombre público del host, así que la
# comprobación de nombre estándar no aplica; db.js verifica ese CN concreto en su lugar.
# DATABASE_CERT_CN=localhost
#
# Último recurso si la validación bloquea el arranque. Cifra pero NO autentica: no impide a un
# intermediario, sólo lo vuelve invisible. Avisa en cada arranque. No dejarlo puesto.
# DATABASE_SSL_NO_VERIFY=true

# Fase 4 step 4 — JSON shutdown complete. customers, quotes, workorders, technicians, and
# payments (payouts) are now SQL-only: no JSON file, no JSON fallback, no dual-write, no
# shadow-read. Their old *_SOURCE / SQL_READ_SHADOW / DUAL_WRITE flags are gone — SQL is the
# only source of truth for these 5 stores, unconditionally.
#
# Every other store (agents, distributors, insurance, vehicleTypes, notes, invoices, expenses,
# and the rest of backend/data/*.json) remains JSON-only on local/committed disk, unaffected
# by this cutover and outside its scope.
