PORT=4000
JWT_SECRET=changeme

DB_HOST=mi_host_mysql_de_hostinger
DB_PORT=3306
DB_USER=mi_usuario_mysql
DB_PASSWORD=mi_contraseña_mysql
DB_NAME=mi_nombre_de_base

# Railway PostgreSQL (app_data cache + Fase 2 cutover tables)
DATABASE_URL=postgresql://user:password@host:port/database

# Fase 1 cutover: read-only SQL shadow mode. When true, list() in the migrated stores
# also queries SQL, diffs it against the JSON response, and logs discrepancies —
# the JSON result is still what's returned to the client either way.
SQL_READ_SHADOW=false
WORKORDERS_SOURCE=json
QUOTES_SOURCE=json
CUSTOMERS_SOURCE=json
PAYMENTS_SOURCE=json
