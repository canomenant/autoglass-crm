{
  "name": "autoglass-crm-backend",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "migrate:schema": "node scripts/migrate-to-postgres/run-schema.js",
    "migrate": "node scripts/migrate-to-postgres/migrate.js",
    "migrate:dry-run": "node scripts/migrate-to-postgres/migrate.js --dry-run",
    "migrate:verify": "node scripts/migrate-to-postgres/lib/verify.js",
    "backup:pg": "node scripts/pg-backup.js",
    "restore:pg": "node scripts/pg-restore.js",
    "db:reset": "node scripts/db-reset.js",
    "populate:appdata": "node scripts/populate-appdata.js",
    "db:populate": "node scripts/migrate-to-postgres/migrate.js --only=job_types,part_numbers,calibration_types,price_tiers,vehicle_types,zip_codes,payment_methods,payment_statuses,tags,expense_categories,partner_companies,users,expenses,table_views,technicians,agents,distributors,insurance_companies",
    "test:security": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.2",
    "pg": "^8.11.5",
    "stripe": "^22.3.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
